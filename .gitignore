# Local tooling, not part of the project
/.claude/
/easyeda-api-skill/

# Operating systems and editors
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
__pycache__/

# Hardware: the large 3D exports, which EasyEDA regenerates, except the
# model of the board, a file of its releases
*.step
*.stp
!/hardware/pcb/*.step

# Firmware: PlatformIO builds and the tools uv installs
firmware/.pio/
firmware/.venv/
firmware/.vscode/*
!firmware/.vscode/extensions.json
firmware/tools/*/touch_replay
firmware/tools/*/touch_replay.exe

# Desktop app
app/node_modules/
app/dist/
# Rust build output: the workspace target, and the capability schemas
# that tauri-build writes
/target/
app/src-tauri/gen/schemas/
# The wchisp sidecar, which the release workflow builds, or a hand-built one
app/src-tauri/binaries/

# Production logs of disled-factory, which hold board UIDs
disled-production*.csv
