# Local tooling, not part of the project
/.claude/
/easyeda-api-skill/

# Operating systems and editors
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
__pycache__/

# Hardware: large generated 3D exports (regenerate them from EasyEDA),
# except the model of the board, a file of its releases (ADR 0019)
*.step
*.stp
!/hardware/pcb/*.step

# Firmware (PlatformIO, tools installed by uv)
firmware/.pio/
firmware/.venv/
firmware/.vscode/*
!firmware/.vscode/extensions.json
firmware/tools/*/touch_replay
firmware/tools/*/touch_replay.exe

# Desktop app (Tauri + Vue)
app/node_modules/
app/dist/
# Rust workspace build output (and the old per-crate location)
/target/
app/src-tauri/target/
app/src-tauri/gen/schemas/
# The wchisp sidecar, built by the release workflow (or by hand)
app/src-tauri/binaries/

# Production logs of disled-factory (board UIDs)
disled-production*.csv
