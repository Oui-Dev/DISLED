{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Every window: the events of the backend, and the developer tools of debug builds",
  "windows": [
    "popup",
    "diagnostics",
    "lamp-update"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:webview:allow-internal-toggle-devtools"
  ]
}
