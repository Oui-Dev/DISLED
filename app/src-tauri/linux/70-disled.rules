#
# DISLED USB status light: give the logged-in user access to the lamp,
# which Linux otherwise reserves to root. Installed by the .deb package;
# see app/README.md for the AppImage. "uaccess" grants access to the
# active local session only, so the file must sort before 73-seat-late.

# The lamp's HID interface (release 1209:0001, debug 1209:0002).
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0001", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0002", TAG+="uaccess"

# The WCH ROM bootloader, for flashing with wchisp (docs/flashing.md).
SUBSYSTEM=="usb", ATTRS{idVendor}=="4348", ATTRS{idProduct}=="55e0", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55e0", TAG+="uaccess"
